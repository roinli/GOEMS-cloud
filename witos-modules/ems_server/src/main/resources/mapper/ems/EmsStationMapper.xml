<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.witos.ems.server.mapper.EmsStationMapper">

    <sql id="stationSelect">
        select s.id as stationId,
               s.tenant_id as tenantId,
               s.company_id as companyId,
               c.company_name as companyName,
               s.station_code as stationCode,
               s.station_name as stationName,
               s.station_type as stationType,
               s.country,
               s.contact_name as contactName,
               s.contact_phone as contactPhone,
               s.run_mode as runMode,
               s.timezone,
               s.image_url as imageUrl,
               s.capacity_kw as capacityKw,
               s.address,
               s.longitude,
               s.latitude,
               s.commission_date as commissionDate,
               s.status,
               null as edgeId,
               null as edgeName,
               null as edgeBinding,
               s.create_time as createTime,
               s.update_time as updateTime,
               s.remark
        from ems_station s
                 left join ems_company c on c.id = s.company_id and c.del_flag = '0'
        where s.del_flag = '0'
    </sql>

    <sql id="stationScope">
        <if test="scope != null and scope.scopeRestricted">
            <choose>
                <when test="(scope.companyIds != null and scope.companyIds.size() > 0) or (scope.stationIds != null and scope.stationIds.size() > 0)">
                    and (
                    <if test="scope.companyIds != null and scope.companyIds.size() > 0">
                        s.company_id in
                        <foreach collection="scope.companyIds" item="companyId" open="(" separator="," close=")">
                            #{companyId}
                        </foreach>
                    </if>
                    <if test="scope.stationIds != null and scope.stationIds.size() > 0">
                        <if test="scope.companyIds != null and scope.companyIds.size() > 0">
                            or
                        </if>
                        s.id in
                        <foreach collection="scope.stationIds" item="stationId" open="(" separator="," close=")">
                            #{stationId}
                        </foreach>
                    </if>
                    )
                </when>
                <otherwise>
                    and 1 = 0
                </otherwise>
            </choose>
        </if>
    </sql>

    <select id="selectStationPage" resultType="java.util.LinkedHashMap">
        <include refid="stationSelect"/>
        <include refid="stationScope"/>
        <include refid="stationQuery"/>
        order by s.id desc
    </select>

    <sql id="stationQuery">
        <if test="query.companyId != null and query.companyId != ''">
            and s.company_id = #{query.companyId}
        </if>
        <if test="query.stationName != null and query.stationName != ''">
            and s.station_name like concat('%', #{query.stationName}, '%')
        </if>
        <if test="query.stationCode != null and query.stationCode != ''">
            and s.station_code like concat('%', #{query.stationCode}, '%')
        </if>
        <if test="query.status != null and query.status != ''">
            and s.status = #{query.status}
        </if>
    </sql>

    <select id="selectStationList" resultType="java.util.LinkedHashMap">
        <include refid="stationSelect"/>
        <include refid="stationScope"/>
        <include refid="stationQuery"/>
        order by s.id desc
    </select>

    <select id="selectStationDetail" resultType="java.util.LinkedHashMap">
        <include refid="stationSelect"/>
        and s.id = #{id}
        <include refid="stationScope"/>
        limit 1
    </select>

</mapper>
